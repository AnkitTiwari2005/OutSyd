# ==============================================================================
# OUTSYD Construction Cost & BOQ Calculator — Environment Configuration
# ==============================================================================

# Database — PostgreSQL connection URL (e.g. Supabase Transaction Pooler or direct connection)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Auth.js v5 secret for signing and encrypting session tokens (generate using: openssl rand -base64 32)
AUTH_SECRET="your-super-secret-auth-key-min-32-chars-long"

# NextAuth v4 backward-compatibility secret (optional if AUTH_SECRET is provided)
NEXTAUTH_SECRET="your-super-secret-auth-key-min-32-chars-long"

# Canonical Public App URL
NEXT_PUBLIC_APP_URL="https://outsyd.com"

# Upstash Redis — Rate limiting (optional in local development, required in production)
UPSTASH_REDIS_REST_URL="https://[YOUR-UPSTASH-INSTANCE].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR-UPSTASH-REST-TOKEN]"

# Supabase Management REST setup scripts (optional, for DB setup scripts)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"
SUPABASE_PROJECT_REF="[YOUR-PROJECT-REF]"
